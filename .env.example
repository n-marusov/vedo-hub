# ====================================================
# VEDO Core — Environment Configuration Template
# ====================================================
# WARNING: never commit a populated .env file.
# Values here are placeholders. Copy to .env and fill
# in your actual credentials before running the project.
# ====================================================

## General Settings
SERVICE_PORT=8080
LOG_LEVEL=info
APP_ENV=development

## API Gateway
UPSTREAM_TIMEOUT=30
QUERY_MAX_LIMIT=1000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Deployment mode: saas, on-premise, or air-gapped
# Controls LLM access policy in the Policy Router
# DEPLOYMENT_MODE=saas

## Keycloak / JWT Authentication
# Path to the JWT public key file (RSA PEM format)
# JWT_PUBLIC_KEY_PATH=/etc/vedo/jwt-public-key.pem
# OR
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/vedo/protocol/openid-connect/certs

## Ontology Service (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME_BEFORE_DEPLOY>

## Versioning Service (PostgreSQL)
DATABASE_URL=postgres://vedo:<CHANGE_ME>@localhost:5432/vedo_versioning

## Redis (caching and locks)
REDIS_URL=redis://localhost:6379/0

## RabbitMQ (messaging)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

## Service URLs (internal gRPC/REST)
ONTOLOGY_SERVICE_URL=http://ontology-service:8082
VERSIONING_SERVICE_URL=http://versioning-service:8083
PUBLISHER_SERVICE_URL=http://publisher-service:8085
COMMENTING_SERVICE_URL=http://commenting-service:8082
SUPPORT_SERVICE_URL=http://support-service:8087
TICKET_API_URL=http://ticket-api:8088
METRICS_SERVICE_URL=http://metrics-service:8084

## Frontend
VITE_GRAPHQL_ENDPOINT=/api/v1/graphql
VITE_API_BASE_URL=http://localhost:8080

## Keycloak OIDC
OIDC_CLIENT_ID=vedo-core
OIDC_CLIENT_SECRET=<CHANGE_ME_BEFORE_DEPLOY>
OIDC_ISSUER_URI=http://localhost:8080/realms/vedo

## Commenting Service (PostgreSQL, separate DB recommended)
# Falls back to DATABASE_URL if not set
# COMMENTING_DATABASE_URL=postgres://vedo:<CHANGE_ME>@localhost:5432/vedo_comments
# Set to "true" to disable auth for local development
# AUTH_DISABLED=false

## Neo4j (ontology graph store)
# Maximum connections in the Neo4j connection pool
# NEO4J_MAX_CONNECTIONS=20

## LLM Provider Configuration (Shared Go Package)
# Default LLM provider (e.g., openai, anthropic, ollama)
LLM_PROVIDER=openai
# API key for the default provider
LLM_API_KEY=
# Default model name (e.g., gpt-4o, claude-3-opus, llama3)
LLM_MODEL=gpt-4o
# Base URL for the default provider (optional; uses provider default)
LLM_BASE_URL=
# Request timeout (e.g., 30s, 60s)
LLM_TIMEOUT=30s
# Maximum tokens in the response
LLM_MAX_TOKENS=4096
# Temperature for generation (0.0-2.0)
LLM_TEMPERATURE=0.7

# Provider-specific overrides (LLM_PROVIDERS_<NAME>_<KEY>)
# LLM_PROVIDERS_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDERS_OLLAMA_MODEL=llama3
# LLM_PROVIDERS_OPENAI_API_KEY=sk-...
# LLM_PROVIDERS_OPENAI_MODEL=gpt-4o
# LLM_PROVIDERS_ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDERS_ANTHROPIC_MODEL=claude-3-opus-20240229

## Document Extractor (Python Service)
# HTTP port for the document-extractor health/metrics endpoints
DOCUMENT_EXTRACTOR_PORT=8092
# Max file size (MB) for synchronous document parsing
MAX_FILE_SIZE_MB=20
# gRPC target for the ontology-service ApplySequence RPC
ONTOLOGY_SERVICE_GRPC_URL=ontology-service:9001
# LLM retry configuration (max attempts with exponential backoff)
LLM_MAX_RETRIES=3
# LLM request timeout in seconds (overrides LLM_TIMEOUT for document-extractor)
LLM_TIMEOUT_SECONDS=120

## gRPC TLS Configuration
# Enable TLS for inter-service gRPC communication
# GRPC_TLS_ENABLED=false
# Path to CA certificate file for client-side TLS verification
# GRPC_CA_CERT_FILE=/etc/vedo/tls/ca.crt
# Server-side TLS certificate and key files
# GRPC_TLS_CERT_FILE=/etc/vedo/tls/grpc-server.crt
# GRPC_TLS_KEY_FILE=/etc/vedo/tls/grpc-server.key

ENABLE_SWAGGER_UI=true
