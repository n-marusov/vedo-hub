# @ctx: Local development secrets for docker-compose.yaml
# @hlv:sec [SECRET_HANDLING] — do not commit real values; use .env.local for overrides
# Source: llm/src/docker-compose.yaml reads these via env_file

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# PostgreSQL
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=vedo

# Neo4j
NEO4J_AUTH=neo4j/password

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# Frontend — Keycloak OIDC (passed as build arg + runtime env)
VITE_KEYCLOAK_REALM=vedo-core
VITE_KEYCLOAK_CLIENT_ID=vedo-spa
VITE_KEYCLOAK_URL=http://127.0.0.1:8443
