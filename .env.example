# =============================================================================
# VEDO Core — Environment Configuration Template
# =============================================================================
# Copy this file to .env.dev, .env.test, or .env.staging and adjust.
#
# Convention:
#   XXX_PORT              — host port (changes between environments)
#   XXX_CONTAINER_PORT    — container port (same across all environments)
#
# Dev:     default ports (no offset)
# Test:    +10000 to all host ports  (RabbitMQ AMQP: +10001)
# Staging: +20000 to all host ports  (RabbitMQ AMQP: +20002)
# =============================================================================

# ── Project Name ────────────────────────────────────────────────────────────
# Must be unique per environment so containers/networks don't collide.
# Dev:     vedo-core-dev
# Test:    vedo-core-test
# Staging: vedo-core-staging
COMPOSE_PROJECT_NAME=vedo-core-dev


# ════════════════════════════════════════════════════════════════════════════
# Infrastructure Host Ports
# ════════════════════════════════════════════════════════════════════════════

# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# PostgreSQL
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Keycloak
KC_HOSTNAME_PORT=8180


# ════════════════════════════════════════════════════════════════════════════
# Application Host Ports
# ════════════════════════════════════════════════════════════════════════════

# Frontend
FRONTEND_PORT=3000

# Publish Browse UI
PUBLISH_BROWSE_UI_PORT=3002

# API Gateway
API_GATEWAY_PORT=8080

# Auth Service (gRPC)
AUTH_SERVICE_GRPC_PORT=9003

# Versioning Service (gRPC)
VERSIONING_SERVICE_GRPC_PORT=9002

# Metrics Service
METRICS_SERVICE_REST_PORT=8084

# Publisher Service (gRPC)
PUBLISHER_SERVICE_GRPC_PORT=9005

# Public Browse API (gRPC)
PUBLIC_BROWSE_GRPC_PORT=9011

# Commenting Service (gRPC)
COMMENTING_SERVICE_GRPC_PORT=9004

# Ticket API (REST + gRPC)
TICKET_API_REST_PORT=8088
TICKET_API_GRPC_PORT=9010

# Ticket Classifier
TICKET_CLASSIFIER_PORT=8089

# Ticket Telemetry Listener
TICKET_TELEMETRY_STUB_PORT=8090

# Ticket Notifier
TICKET_NOTIFIER_STUB_PORT=8091

# Document Extractor (gRPC)
DOCUMENT_EXTRACTOR_GRPC_PORT=9013

# AI Orchestration (health port)
AI_ORCH_HEALTH_PORT=8093
AI_ORCH_GRPC_PORT=9014


# ════════════════════════════════════════════════════════════════════════════
# Profile Ports — only needed when using --profile flags
# ════════════════════════════════════════════════════════════════════════════

# Observability (--profile obs)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_PROMETHEUS_PORT=8888
OTEL_COLLECTOR_HEALTH_PORT=8889

# LLM / Ollama (--profile llm)
OLLAMA_PORT=11434

# Documentation (--profile documentation)
DOCS_USER_PORT=5000
DOCS_DEV_PORT=5001
DOCS_ADMIN_PORT=5002
DOCS_INTEGRATOR_PORT=5003


# ════════════════════════════════════════════════════════════════════════════
# Credentials (change for production/staging)
# ════════════════════════════════════════════════════════════════════════════

# Neo4j
NEO4J_AUTH=neo4j/password

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vedo_versioning

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost

# Keycloak — Client config (for auth-service and frontend)
KEYCLOAK_REALM=vedo-core
KEYCLOAK_CLIENT_ID=vedo-core-api
KEYCLOAK_CLIENT_SECRET=vedo-core-api-secret
VITE_KEYCLOAK_REALM=vedo-core
VITE_KEYCLOAK_CLIENT_ID=vedo-core-frontend


# ════════════════════════════════════════════════════════════════════════════
# Service URLs (for inter-service communication via container network)
# ════════════════════════════════════════════════════════════════════════════
# These use container ports (XXX_CONTAINER_PORT) and service names as hostnames.
# Override only if you need custom routing.

# VITE_KEYCLOAK_URL=http://localhost:${KC_HOSTNAME_PORT:-8180}
# VITE_API_URL=http://localhost:${API_GATEWAY_PORT:-8080}
# VITE_WS_URL=ws://localhost:${API_GATEWAY_PORT:-8080}
# NEO4J_URI=bolt://neo4j:${NEO4J_BOLT_CONTAINER_PORT:-7687}
# DATABASE_URL=postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-password}@postgres:${POSTGRES_CONTAINER_PORT:-5432}/vedo_versioning
# REDIS_URL=redis://redis:${REDIS_CONTAINER_PORT:-6379}
# RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER:-guest}:${RABBITMQ_DEFAULT_PASS:-guest}@rabbitmq:${RABBITMQ_CONTAINER_AMQP_PORT:-5672}/


# ════════════════════════════════════════════════════════════════════════════
# LLM Configuration (optional — for document-extractor AI features)
# ════════════════════════════════════════════════════════════════════════════
# LLM_PROVIDER=openai            # openai, anthropic, or ollama
# LLM_API_KEY=sk-...             # API key for the provider
# LLM_MODEL=gpt-4o-mini          # Model identifier
# LLM_BASE_URL=                  # Custom base URL for OpenAI-compatible APIs
# LLM_PROVIDERS_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDERS_OLLAMA_MODEL=llama3


# ════════════════════════════════════════════════════════════════════════════
# Test / Staging: uncomment and add offset
# ════════════════════════════════════════════════════════════════════════════
# For Test (+10000):
#   COMPOSE_PROJECT_NAME=vedo-core-test
#   NEO4J_HTTP_PORT=17474
#   NEO4J_BOLT_PORT=17687
#   POSTGRES_PORT=15432
#   REDIS_PORT=16379
#   RABBITMQ_AMQP_PORT=15673   ← note: +10001, not +10000
#   RABBITMQ_MGMT_PORT=25672
#   ... (add +10000 to all other host ports)
#
# For Staging (+20000):
#   COMPOSE_PROJECT_NAME=vedo-core-staging
#   NEO4J_HTTP_PORT=27474
#   NEO4J_BOLT_PORT=27687
#   POSTGRES_PORT=25432
#   REDIS_PORT=26379
#   RABBITMQ_AMQP_PORT=25674   ← note: +20002, not +20000
#   RABBITMQ_MGMT_PORT=35672
#   ... (add +20000 to all other host ports)
