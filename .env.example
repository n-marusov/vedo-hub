# =============================================================================
# VEDO Core — Environment Configuration Example
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# All variables have safe defaults for local development.

# =============================================================================
# Logging
# =============================================================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# API Gateway (Go — port 8080)
# =============================================================================
SERVICE_PORT=8080
ONTOLOGY_SERVICE_URL=http://localhost:8082
VERSIONING_SERVICE_URL=http://localhost:8083

# =============================================================================
# Ontology Service (Rust — port 8082)
# =============================================================================
# SERVICE_PORT=8082
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_MAX_CONNECTIONS=10

# =============================================================================
# Versioning Service (Rust — port 8083)
# =============================================================================
# SERVICE_PORT=8083
DATABASE_URL=postgres://vedo:vedo@localhost:5432/vedo_versioning
PG_MAX_CONNECTIONS=10

# =============================================================================
# Frontend (Vue 3 + Vite — port 5173)
# =============================================================================
VITE_GRAPHQL_ENDPOINT=/api/v1/graphql
VITE_APP_VERSION=0.2.0
VITE_APP_ENV=development
# VITE_KEYCLOAK_URL=http://localhost:8080/realms/vedo
# VITE_KEYCLOAK_REALM=vedo
# VITE_KEYCLOAK_CLIENT_ID=vedo-frontend

# =============================================================================
# Integration Tests
# =============================================================================
# NEO4J_TEST_URI=bolt://localhost:7688
# PG_TEST_DATABASE_URL=postgres://vedo:vedo@localhost:5433/vedo_versioning_test
