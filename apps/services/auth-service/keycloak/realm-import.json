{
  "realm": "vedo-core",
  "enabled": true,
  "displayName": "VEDO Core",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "Viewer", "composite": false },
      { "name": "Editor", "composite": false },
      { "name": "Maintainer", "composite": false },
      { "name": "Owner", "composite": true, "composites": { "realm": ["Viewer", "Editor", "Maintainer"] } },
      { "name": "SupportEngineer", "composite": false },
      { "name": "SRE", "composite": false },
      { "name": "SecurityLead", "composite": false },
      { "name": "ProductOwner", "composite": true, "composites": { "realm": ["Viewer", "Editor"] } }
    ]
  },
  "clients": [
    {
      "clientId": "vedo-spa",
      "name": "VEDO Core SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "https://app.vedo.dev/*"],
      "webOrigins": ["http://localhost:3000", "https://app.vedo.dev"],
      "attributes": { "post.logout.redirect.uris": "+" }
    },
    {
      "clientId": "vedo-cli",
      "name": "VEDO CLI",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": { "access.token.lifespan": "86400" }
    },
    {
      "clientId": "auth-service",
      "name": "Auth Service (internal)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": false,
      "attributes": { "access.token.lifespan": "300" }
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex",
      "providerId": "yandex",
      "enabled": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "config": { "clientId": "${YANDEX_CLIENT_ID}", "clientSecret": "${YANDEX_CLIENT_SECRET}" }
    },
    {
      "alias": "vk",
      "displayName": "VK",
      "providerId": "vk",
      "enabled": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "config": { "clientId": "${VK_CLIENT_ID}", "clientSecret": "${VK_CLIENT_SECRET}" }
    }
  ],
  "groups": [],
  "defaultGroups": ["Viewer"],
  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "Browser-based authentication",
      "providerId": "basic-flow",
      "builtIn": true,
      "topLevel": true,
      "authenticationExecutions": [
        { "authenticatorConfig": "auth-username-password-form", "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10 },
        { "authenticatorConfig": "auth-otp-form", "authenticator": "auth-otp-form", "requirement": "CONDITIONAL", "priority": 20 }
      ]
    }
  ],
  "requiredActions": ["UPDATE_PASSWORD", "VERIFY_EMAIL"],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "1; mode=block"
  },
  "smtpServer": {}
}
