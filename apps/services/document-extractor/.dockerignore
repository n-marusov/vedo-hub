# ==============================================================================
# Docker build context exclusions — document-extractor service
# ==============================================================================

# Python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/

# Test files (not needed in production image)
tests/
*.test.py

# Version control
.git/
.gitignore
.gitattributes

# Environment files
.env
.env.*
!.env.example

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in runtime)
*.md
README.rst
