{
	"packageManager": "pnpm@11.18.0",
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"typecheck": "vue-tsc --noEmit",
		"diagnostics": "vue-tsc --noEmit",
		"codegen": "graphql-codegen --config codegen.ts",
		"codegen:check": "graphql-codegen --config codegen.ts --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check --write .",
		"lint:ci": "biome ci .",
		"fix:types": "node scripts/fix-types.mjs",
		"postinstall": "lefthook install"
	},
	"dependencies": {
		"@apollo/client": "^3.11.0",
		"@lucide/vue": "^1.27.0",
		"@vue-flow/background": "^1.3.2",
		"@vue-flow/controls": "^1.1.3",
		"@vue-flow/core": "^1.48.2",
		"@vue/apollo-composable": "^4.2.0",
		"axios": "^1.18.1",
		"graphql": "^16.9.0",
		"vue": "^3.5.0",
		"vue-router": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@graphql-codegen/cli": "^7.2.0",
		"@graphql-codegen/client-preset": "^6.1.0",
		"@graphql-codegen/typescript": "^6.1.0",
		"@graphql-codegen/typescript-operations": "^6.1.2",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@types/node": "^26.1.1",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/test-utils": "^2.4.6",
		"brace-expansion": "^5.0.8",
		"jsdom": "^25.0.1",
		"lefthook": "^2.1.10",
		"typescript": "^5.5.4",
		"vite": "^6.4.3",
		"vitest": "^3.2.6",
		"vue-tsc": "^3.3.8"
	}
}
