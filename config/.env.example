# =============================================================================
# VEDO Core — Environment Variables Reference
# =============================================================================
# Copy this file to override values for your environment:
#   cp config/.env.example config/.env.dev
#
# For local-only overrides (not committed):
#   touch config/.env.local
#
# NEVER commit real secrets. Use placeholder values here.
# =============================================================================

# ─── Public Services (host ports) ─────────────────────────────────────────────
# These ports are mapped to your host machine.

API_GATEWAY_PORT=8080
FRONTEND_PORT=3000
PUBLISH_BROWSE_UI_PORT=3002
KC_HOSTNAME_PORT=8180

# ─── Infrastructure (host ports) ─────────────────────────────────────────────

NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Credentials (change for production) ─────────────────────────────────────

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_CLIENT_ID=vedo-core-api
KEYCLOAK_CLIENT_SECRET=vedo-core-api-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vedo_versioning

# Neo4j
NEO4J_AUTH=neo4j/password
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Uncomment and configure for AI-assisted ontology features.

# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=

# ─── TLS / gRPC ──────────────────────────────────────────────────────────────
# Leave empty for development (no TLS). Set paths for production.

# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT_FILE=
# GRPC_TLS_KEY_FILE=
# GRPC_CA_CERT_FILE=

# ─── Observability ────────────────────────────────────────────────────────────
# OTEL collector endpoint for distributed tracing.

# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ─── Environment Metadata ─────────────────────────────────────────────────────

APP_ENV=development
APP_VERSION=0.2.0
ENABLE_SWAGGER_UI=true

# ─── Frontend Public Domain ───────────────────────────────────────────────────
# Public domain/host of the VEDO frontend. Passed to the browser at runtime
# via window.__VEDO_CONFIG__.PUBLIC_DOMAIN (docker-entrypoint.sh → config.js)
# and used as the immutable prefix when building group/project URLs.
# Set per environment, e.g. https://vedo.example.com or http://localhost:3000.

PUBLIC_DOMAIN=vedo-core.local
