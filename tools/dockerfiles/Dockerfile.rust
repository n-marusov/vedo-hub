# @ctx: Centralized multi-stage Rust builder — workspace-aware
#
# Build (from project root):
#   docker build -f tools/dockerfiles/Dockerfile.rust \
#     --build-arg BINARY_NAME=<name> --build-arg SERVICE_DIR=apps/services \
#     -t vedo-core/<name>:latest .
#
# Args:
#   RUST_BASE_IMAGE    — builder image (default: rust:1.89)
#   RUST_RUNTIME_IMAGE — runtime image (default: debian:bookworm-slim)
#   BINARY_NAME        — package name in Cargo workspace, e.g. "ontology-service"
#   SERVICE_DIR        — workspace root containing Cargo.toml + member dirs
#
# NOTE: The COPY commands below list ALL workspace members explicitly.
# When [workspace.members] in Cargo.toml changes, update these lists.
# NOTE: shared crate is at apps/shared/ — must be copied separately.
# Current members: ontology-service, versioning-service, shared,
#                  publisher-service, public-browse-api

ARG RUST_BASE_IMAGE=rust:1.89
ARG RUST_RUNTIME_IMAGE=debian:bookworm-slim

# ── Builder Stage ──────────────────────────────────────────────────────────────
FROM ${RUST_BASE_IMAGE} AS builder

ARG BINARY_NAME
ARG SERVICE_DIR

WORKDIR /src

# Install protoc for tonic_build (compiles .proto → .rs at compile time)
RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

# ── Step 1: Workspace manifests ────────────────────────────────────────────────
# Copy workspace root Cargo.toml
COPY ${SERVICE_DIR}/Cargo.toml ./

# Copy ALL workspace member Cargo.toml files so cargo can validate the workspace
COPY ${SERVICE_DIR}/shared/Cargo.toml ./shared/
COPY ${SERVICE_DIR}/ontology-service/Cargo.toml ./ontology-service/
COPY ${SERVICE_DIR}/versioning-service/Cargo.toml ./versioning-service/
COPY ${SERVICE_DIR}/publisher-service/Cargo.toml ./publisher-service/
COPY ${SERVICE_DIR}/public-browse-api/Cargo.toml ./public-browse-api/

# ── Step 2: Dummy sources for dependency caching ──────────────────────────────
# Create placeholder files so `cargo build` can generate dependency lock
RUN mkdir -p shared/src shared/proto ontology-service/src \
             versioning-service/src publisher-service/src public-browse-api/src \
    && echo "fn main() {}" > shared/build.rs \
    && echo "// placeholder" > shared/src/lib.rs \
    && echo "fn main() {}" > ontology-service/src/main.rs \
    && echo "fn main() {}" > versioning-service/src/main.rs \
    && echo "fn main() {}" > publisher-service/src/main.rs \
    && echo "fn main() {}" > public-browse-api/src/main.rs

# Cache dependencies (expected to fail on final link — that's OK, cache is what matters)
RUN cargo build --package ${BINARY_NAME} --release 2>/dev/null || true

# ── Step 3: Real sources ───────────────────────────────────────────────────────
# Copy real shared crate (includes proto files for tonic_build)
COPY ${SERVICE_DIR}/shared/src/ ./shared/src/
COPY ${SERVICE_DIR}/shared/proto/ ./shared/proto/
COPY ${SERVICE_DIR}/shared/build.rs ./shared/

# Copy real service source (overwrites dummy src/ and includes optional build.rs)
COPY ${SERVICE_DIR}/${BINARY_NAME}/ ./${BINARY_NAME}/

# Wipe stale cached build artifacts from dummy build.rs so tonic_build
# regenerates protobuf stubs from real proto files
RUN rm -rf target/release/build/vedo-shared-* 2>/dev/null; true

# Build for real
RUN cargo build --package ${BINARY_NAME} --release


# ── Runtime Stage ──────────────────────────────────────────────────────────────
FROM ${RUST_RUNTIME_IMAGE} AS runtime

ARG BINARY_NAME

WORKDIR /app

# libssl3 for reqwest (HTTPS/gRPC-TLS), ca-certificates for TLS verification
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/${BINARY_NAME} /app/service

EXPOSE 8080

CMD ["/app/service"]
