# @ctx: Centralized multi-stage TypeScript/Vue builder — pnpm + nginx
#
# Build (from project root):
#   docker build -f tools/dockerfiles/Dockerfile.typescript \
#     --build-arg SERVICE_DIR=apps/services/<name> \
#     -t vedo-core/<name>:latest .
#
# Args:
#   NODE_IMAGE     — builder image (default: node:22-alpine)
#   NGINX_IMAGE    — runtime image (default: nginx:1.27-alpine-slim)
#   SERVICE_DIR    — path to service directory relative to context
#   BUILD_PROFILE  — production (tree-shaken) | e2e | dev (SKIP_AUTH enabled)

ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine-slim

# ── Builder Stage ──────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS builder

ARG SERVICE_DIR

WORKDIR /app

# Install pnpm and configure for hoisted node_modules
RUN corepack enable && \
    echo "node-linker=hoisted" > .npmrc && \
    echo "minimumReleaseAge=0" >> .npmrc

# VITE_* build args removed — configuration is now injected at runtime
# via docker-entrypoint.sh which generates /usr/share/nginx/html/config.js
# from VEDO_* environment variables. No rebuild needed when switching
# environments (dev/test/staging).
#
# BUILD_PROFILE controls the Vite build mode and feature flags:
#   production (default) — SKIP_AUTH tree-shaken, most secure
#   e2e                 — SKIP_AUTH enabled (Playwright E2E tests)
#   dev                 — SKIP_AUTH enabled (local Docker dev)
ARG BUILD_PROFILE=production

# Copy dependency manifests first for layer caching
# pnpm-workspace.yaml must be copied too — the lockfile records overrides/
# onlyBuiltDependencies from it; without it, --frozen-lockfile fails with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
COPY ${SERVICE_DIR}/package.json ${SERVICE_DIR}/pnpm-lock.yaml* ${SERVICE_DIR}/pnpm-workspace.yaml* ./

# Install dependencies with frozen lockfile for reproducibility
# minimumReleaseAge=0 bypasses recent-package supply-chain check for CI builds
RUN pnpm install --frozen-lockfile --ignore-scripts --config.minimumReleaseAge=0

# Copy application source code
COPY ${SERVICE_DIR}/ .

# Build — vite handles TS transpilation without typecheck.
# BUILD_PROFILE → vite --mode: production (tree-shaken), e2e/dev (SKIP_AUTH enabled).
RUN npx vite build --mode ${BUILD_PROFILE}

# Pre-compress text-based assets for nginx gzip_static.
# Saves CPU at runtime — nginx serves .gz files directly instead of
# compressing on every request. Adds ~30% to dist size, acceptable trade-off.
RUN find /app/dist -type f \( -name "*.js" -o -name "*.css" -o -name "*.html" -o -name "*.json" -o -name "*.svg" -o -name "*.txt" \) \
      -exec gzip -9 -k {} \;


# ── Runtime Stage ──────────────────────────────────────────────────────────────
FROM ${NGINX_IMAGE} AS runtime

ARG SERVICE_DIR

# Copy built static files (includes pre-compressed .gz variants)
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY ${SERVICE_DIR}/nginx.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script (generates runtime config.js from env vars)
# --chmod=755 replaces a separate RUN chmod layer
COPY --chmod=755 ${SERVICE_DIR}/docker-entrypoint.sh /docker-entrypoint.sh

EXPOSE 80

STOPSIGNAL SIGQUIT

ENTRYPOINT ["/docker-entrypoint.sh"]
