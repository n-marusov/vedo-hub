# @ctx: Centralized multi-stage TypeScript/Vue builder — pnpm + nginx
#
# Build (from project root):
#   docker build -f tools/dockerfiles/Dockerfile.typescript \
#     --build-arg SERVICE_DIR=apps/services/<name> \
#     -t vedo-core/<name>:latest .
#
# Args:
#   NODE_IMAGE    — builder image (default: node:20-alpine)
#   NGINX_IMAGE   — runtime image (default: nginx:1.25-alpine)
#   SERVICE_DIR   — path to service directory relative to context
#   VITE_*        — any VITE_ prefixed build args (injected as ENV for vite)

ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.25-alpine

# ── Builder Stage ──────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS builder

ARG SERVICE_DIR

WORKDIR /app

# Install pnpm 11 (compatible with Node.js 22)
RUN npm install -g pnpm@11

# Configure pnpm to use hoisted node_modules (npm-compatible)
RUN echo "node-linker=hoisted" > .npmrc
RUN echo "minimumReleaseAge=0" >> .npmrc

# VITE_* build args — vite reads these at build time (ENV instead of ARG so
# they're visible during the build step)
ARG VITE_KEYCLOAK_REALM=
ARG VITE_KEYCLOAK_CLIENT_ID=
ARG VITE_KEYCLOAK_URL=
ARG VITE_SKIP_AUTH=
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_SKIP_AUTH=${VITE_SKIP_AUTH}

# Copy dependency manifests first for layer caching
# pnpm-workspace.yaml must be copied too — the lockfile records overrides/
# onlyBuiltDependencies from it; without it, --frozen-lockfile fails with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
COPY ${SERVICE_DIR}/package.json ${SERVICE_DIR}/pnpm-lock.yaml* ${SERVICE_DIR}/pnpm-workspace.yaml* ./

# Install dependencies with frozen lockfile for reproducibility
# minimumReleaseAge=0 bypasses recent-package supply-chain check for CI builds
RUN pnpm install --frozen-lockfile --ignore-scripts --config.minimumReleaseAge=0

# Copy application source code
COPY ${SERVICE_DIR}/ .

# Build — vite handles TS transpilation without typecheck
RUN npx vite build


# ── Runtime Stage ──────────────────────────────────────────────────────────────
FROM ${NGINX_IMAGE} AS runtime

ARG SERVICE_DIR

# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config if it exists in the service directory
COPY ${SERVICE_DIR}/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
