# @ctx: Centralized multi-stage Python builder — uv-based
#
# Build (from project root):
#   docker build -f tools/dockerfiles/Dockerfile.python \
#     --build-arg SERVICE_DIR=apps/services/<name> \
#     -t vedo-core/<name>:latest .
#
# Args:
#   PYTHON_IMAGE       — builder image (default: python:3.12-slim)
#   PYTHON_RUNTIME_IMAGE — runtime image (default: python:3.12-slim)
#   SERVICE_DIR        — path to service directory relative to context

ARG PYTHON_IMAGE=python:3.12-slim
ARG PYTHON_RUNTIME_IMAGE=python:3.12-slim

# ── Builder Stage ──────────────────────────────────────────────────────────────
FROM ${PYTHON_IMAGE} AS builder

ARG SERVICE_DIR

WORKDIR /build

# Install uv (fast Python package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy dependency files first for layer caching
COPY ${SERVICE_DIR}/pyproject.toml ${SERVICE_DIR}/uv.lock ./

# Install production dependencies (frozen = use lockfile, no-dev = prod only)
RUN uv sync --frozen --no-dev --no-editable

# Copy application source code
COPY ${SERVICE_DIR}/ .

# Re-run uv sync to install the package itself (non-editable)
RUN uv sync --frozen --no-dev --no-editable


# ── Runtime Stage ──────────────────────────────────────────────────────────────
FROM ${PYTHON_RUNTIME_IMAGE} AS runtime

WORKDIR /app

# Copy installed dependencies and application from builder
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build /app/

ENV PATH="/app/.venv/bin:$PATH"
ENV HOST=0.0.0.0
EXPOSE 8080

CMD ["python", "-u", "main.py"]
