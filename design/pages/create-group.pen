{
  "version": "2.13",
  "children": [
    {
      "type": "frame",
      "id": "cgPage",
      "name": "Create Group",
      "width": 1920,
      "height": 1080,
      "x": 0,
      "y": 0,
      "fill": "$B:background",
      "layout": "vertical",
      "clip": true,
      "children": [
        {
          "id": "cgHeader",
          "type": "ref",
          "ref": "B:qpgfz",
          "name": "pageHeader",
          "width": "fill_container",
          "height": 56
        },
        {
          "type": "frame",
          "id": "cgMain",
          "name": "mainRow",
          "width": "fill_container",
          "height": "fill_container",
          "children": [
            {
              "id": "cgSidebar",
              "type": "ref",
              "ref": "B:W5vtj",
              "name": "pageSidebar",
              "width": 256,
              "height": "fill_container",
              "descendants": {
                "B:swHomeItem": { "fill": "$B:card" },
                "B:swGroupsItem": { "fill": "#10b9811A" }
              }
            },
            {
              "type": "frame",
              "id": "cgContent",
              "name": "pageContent",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [32, 40],
              "fill": "$B:background",
              "children": [
                {
                  "type": "frame",
                  "id": "cgHead",
                  "name": "pageHead",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "frame",
                      "id": "cgBreadcrumbs",
                      "name": "breadcrumbs",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        { "type": "text", "id": "cgBcWs", "content": "Workspace", "fontFamily": "IBM Plex Mono", "fontSize": 11, "fill": "$B:muted-foreground" },
                        { "type": "icon", "id": "cgBcS1", "library": "lucide", "icon": "chevron-right", "width": 12, "height": 12, "fill": "$B:muted-foreground" },
                        { "type": "text", "id": "cgBcGr", "content": "Groups", "fontFamily": "IBM Plex Mono", "fontSize": 11, "fill": "$B:muted-foreground" },
                        { "type": "icon", "id": "cgBcS2", "library": "lucide", "icon": "chevron-right", "width": 12, "height": 12, "fill": "$B:muted-foreground" },
                        { "type": "text", "id": "cgBcNew", "content": "New group", "fontFamily": "IBM Plex Mono", "fontSize": 11, "fontWeight": "600", "fill": "$B:foreground" }
                      ]
                    },
                    { "type": "text", "id": "cgTitle", "content": "New group", "fontFamily": "IBM Plex Mono", "fontSize": 24, "fontWeight": "600", "fill": "$B:foreground" },
                    { "type": "text", "id": "cgSubtitle", "content": "Groups organize projects, members, and subgroups with role-based access control.", "fontFamily": "IBM Plex Mono", "fontSize": 13, "fill": "$B:muted-foreground", "textGrowth": "fixed-width", "width": "fill_container" }
                  ]
                },
                {
                  "type": "frame",
                  "id": "cgFormCard",
                  "name": "formCard",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 24,
                  "padding": 24,
                  "cornerRadius": 8,
                  "fill": "$B:card",
                  "stroke": "$B:border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "children": [
                    {
                      "type": "frame",
                      "id": "cgNameRow",
                      "name": "nameField",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        { "type": "text", "id": "cgNameLabel", "content": "Group name", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fontWeight": "500", "fill": "$B:foreground" },
                        { "type": "text", "id": "cgNameHelp", "content": "Start with a letter, digit, emoji, or underscore.", "fontFamily": "IBM Plex Mono", "fontSize": 11, "fill": "$B:muted-foreground" },
                        {
                          "type": "frame",
                          "id": "cgNameInput",
                          "name": "nameInput",
                          "width": "fill_container",
                          "height": 36,
                          "cornerRadius": 6,
                          "padding": [4, 12],
                          "fill": "$B:background",
                          "stroke": "$B:input",
                          "strokeWidth": 1,
                          "strokeAlignment": "inner",
                          "alignItems": "center",
                          "children": [
                            { "type": "text", "id": "cgNamePh", "content": "My group", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fill": "$B:muted-foreground" }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cgUrlRow",
                      "name": "urlField",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        { "type": "text", "id": "cgUrlLabel", "content": "Group URL", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fontWeight": "500", "fill": "$B:foreground" },
                        {
                          "type": "frame",
                          "id": "cgUrlPreview",
                          "name": "urlPreview",
                          "width": "fill_container",
                          "height": 36,
                          "cornerRadius": 6,
                          "padding": [4, 12],
                          "fill": "$B:background",
                          "stroke": "$B:input",
                          "strokeWidth": 1,
                          "strokeAlignment": "inner",
                          "alignItems": "center",
                          "gap": 0,
                          "children": [
                            { "type": "text", "id": "cgUrlPrefix", "content": "vedo-core.local/", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fill": "$B:muted-foreground" },
                            { "type": "text", "id": "cgUrlSlug", "content": "my-group", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fill": "$B:foreground", "opacity": 0.6 }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cgVisSection",
                      "name": "visibilitySection",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 12,
                      "children": [
                        { "type": "text", "id": "cgVisLabel", "content": "Visibility level", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fontWeight": "500", "fill": "$B:foreground" },
                        { "type": "text", "id": "cgVisHelp", "content": "Choose who can see and access this group.", "fontFamily": "IBM Plex Mono", "fontSize": 13, "fill": "$B:muted-foreground", "textGrowth": "fixed-width", "width": "fill_container" },
                        {
                          "type": "frame",
                          "id": "cgVisOpts",
                          "name": "visOptions",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 8,
                          "children": [
                            {
                              "type": "frame",
                              "id": "cgVisPriv",
                              "name": "visPrivate",
                              "width": "fill_container",
                              "padding": 12,
                              "cornerRadius": 8,
                              "fill": "$B:background",
                              "stroke": "$B:primary",
                              "strokeWidth": 1.5,
                              "strokeAlignment": "inner",
                              "alignItems": "center",
                              "gap": 12,
                              "children": [
                                { "id": "cgRadioPriv", "type": "ref", "ref": "B:nCzv2", "name": "radioPrivate", "descendants": { "B:heLGy": { "content": "" } } },
                                {
                                  "type": "frame",
                                  "id": "cgPrivInfo",
                                  "name": "privInfo",
                                  "layout": "vertical",
                                  "gap": 2,
                                  "width": "fill_container",
                                  "children": [
                                    { "type": "text", "id": "cgPrivTitle", "content": "Private", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fontWeight": "500", "fill": "$B:foreground" },
                                    { "type": "text", "id": "cgPrivDesc", "content": "Only group members can see this group", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fill": "$B:muted-foreground" }
                                  ]
                                },
                                { "type": "icon", "id": "cgPrivIcon", "library": "lucide", "icon": "lock", "width": 16, "height": 16, "fill": "$B:muted-foreground" }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "cgVisInt",
                              "name": "visInternal",
                              "width": "fill_container",
                              "padding": 12,
                              "cornerRadius": 8,
                              "fill": "$B:background",
                              "stroke": "$B:border",
                              "strokeWidth": 1,
                              "strokeAlignment": "inner",
                              "alignItems": "center",
                              "gap": 12,
                              "children": [
                                { "id": "cgRadioInt", "type": "ref", "ref": "B:nCzv2", "name": "radioInternal", "descendants": { "B:heLGy": { "content": "" }, "B:0OdbE": { "enabled": false } } },
                                {
                                  "type": "frame",
                                  "id": "cgIntInfo",
                                  "name": "intInfo",
                                  "layout": "vertical",
                                  "gap": 2,
                                  "width": "fill_container",
                                  "children": [
                                    { "type": "text", "id": "cgIntTitle", "content": "Internal", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fontWeight": "500", "fill": "$B:foreground" },
                                    { "type": "text", "id": "cgIntDesc", "content": "Any authenticated user can see this group", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fill": "$B:muted-foreground" }
                                  ]
                                },
                                { "type": "icon", "id": "cgIntIcon", "library": "lucide", "icon": "users", "width": 16, "height": 16, "fill": "$B:muted-foreground" }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "cgVisPub",
                              "name": "visPublic",
                              "width": "fill_container",
                              "padding": 12,
                              "cornerRadius": 8,
                              "fill": "$B:background",
                              "stroke": "$B:border",
                              "strokeWidth": 1,
                              "strokeAlignment": "inner",
                              "alignItems": "center",
                              "gap": 12,
                              "children": [
                                { "id": "cgRadioPub", "type": "ref", "ref": "B:nCzv2", "name": "radioPublic", "descendants": { "B:heLGy": { "content": "" }, "B:0OdbE": { "enabled": false } } },
                                {
                                  "type": "frame",
                                  "id": "cgPubInfo",
                                  "name": "pubInfo",
                                  "layout": "vertical",
                                  "gap": 2,
                                  "width": "fill_container",
                                  "children": [
                                    { "type": "text", "id": "cgPubTitle", "content": "Public", "fontFamily": "IBM Plex Mono", "fontSize": 14, "fontWeight": "500", "fill": "$B:foreground" },
                                    { "type": "text", "id": "cgPubDesc", "content": "Anyone on the internet can see this group", "fontFamily": "IBM Plex Mono", "fontSize": 12, "fill": "$B:muted-foreground" }
                                  ]
                                },
                                { "type": "icon", "id": "cgPubIcon", "library": "lucide", "icon": "globe", "width": 16, "height": 16, "fill": "$B:muted-foreground" }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cgActions",
                      "name": "formActions",
                      "width": "fill_container",
                      "justifyContent": "end",
                      "gap": 12,
                      "padding": [8, 0, 0, 0],
                      "children": [
                        { "id": "cgCancelBtn", "type": "ref", "ref": "B:c8T4z", "name": "cancelButton", "descendants": { "B:esH0z": { "content": "Cancel" } } },
                        { "id": "cgCreateBtn", "type": "ref", "ref": "B:3CI7c", "name": "createButton", "descendants": { "B:wMRLg": { "content": "Create group" } } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "cgToast",
          "type": "ref",
          "ref": "B:qX56y",
          "name": "successToast",
          "layoutPosition": "absolute",
          "x": 24,
          "y": 80,
          "width": 320,
          "enabled": false,
          "descendants": {
            "B:z7YSd": { "content": "Group created successfully" }
          }
        }
      ]
    }
  ],
  "imports": {
    "B": "../ui-kit.lib.pen"
  }
}
