                  "width": "fill_container",
                  "descendants": {
                    "B:Ap3op": {
                      "content": "Продукт"
                    },
                    "B:kaoPr": {
                      "content": "Product ontology: goods, categories, manufacturers, reviews."
                    }
                  }
                },
                {
                  "id": "landingDemo2",
                  "type": "ref",
                  "ref": "B:Nie8I",
                  "width": "fill_container",
                  "descendants": {
                    "B:Ap3op": {
                      "content": "Организация"
                    },
                    "B:kaoPr": {
                      "content": "Organization structure: departments, employees, roles."
                    }
                  }
                },
                {
                  "id": "landingDemo3",
                  "type": "ref",
                  "ref": "B:Nie8I",
                  "width": "fill_container",
                  "descendants": {
                    "B:Ap3op": {
                      "content": "Процесс"
                    },
