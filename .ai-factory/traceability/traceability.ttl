# INSTANCES — E2E Test Suites (Keycloak Auth)
# =============================================================================

base:test/keycloak-login-e2e a vdo:TestSuite ;
    rdfs:label "Keycloak Login E2E Tests"@en ;
    rdfs:comment "Playwright E2E tests for full Keycloak OIDC authorization code + PKCE login flow: unauthenticated redirect, Corporate SSO initiation, credential entry, callback handling, role assertion, invalid credential rejection"@en ;
