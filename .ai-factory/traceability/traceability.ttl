# CHANGE IMPACT ANALYSIS
# =============================================================================
# The affectedBy relationships document change impact chains:
# If artifact A affectedBy B, changing B may require changes to A.

base:nfr/security-bola-bfla vdo:verifiedBy base:test/bola-bfla-gate .
base:service/api-gateway vdo:verifiedBy base:test/cli-contracts, base:test/docker-build .

# Changing base:spec/cli-ticket-ops-001 affects:
base:spec/cli-ticket-ops-001 vdo:affectedBy base:cli/close-ticket, base:cli/comment-ticket, base:cli/list-tickets, base:cli/reopen-ticket, base:cli/show-ticket .

# Changing security boundary affects:
base:security/auth-boundary vdo:affectedBy base:service/api-gateway, base:service/auth-service, base:service/frontend, base:cli/vedo-cli .

# Changing frontend design affects (see DESIGN → GUI TRACEABILITY LINKS at end of file for detailed page-level traces):
base:design/frontend vdo:affectedBy base:service/frontend .

# Changing deployment affects:
base:deploy/docker-compose vdo:affectedBy base:service/api-gateway, base:service/ontology-service, base:service/versioning-service, base:service/auth-service, base:service/frontend, base:service/metrics-service, base:service/document-extractor .

