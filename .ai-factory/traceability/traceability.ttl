@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix vdo:    <http://vedo.dev/ontology/traceability#> .
@prefix base:   <file:///vedo-hub/> .

# =============================================================================
# VEDO Traceability Ontology
# =============================================================================
# Defines classes and properties for artifact traceability across business
# requirements, architecture decisions, code, tests, documentation,
# deployment, and observability.
# Generated from HLV metadata analysis of VEDO Core project.
# =============================================================================

vdo:TraceabilityOntology a owl:Ontology ;
    rdfs:label "VEDO Core Traceability Ontology"@en ;
    rdfs:comment "Ontology for artifact traceability in VEDO Core project, derived from HLV metadata annotations."@en ;
    dct:created "2026-07-12"^^xsd:date ;
    dct:creator "AI Factory (aif)" .

# =============================================================================
# CLASSES — Artifact Types
# =============================================================================

vdo:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Base class for all traceable artifacts in the VEDO Core ecosystem."@en .

vdo:BusinessRequirement a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Business Requirement"@en ;
    rdfs:comment "Business-level requirement describing stakeholder needs and strategic goals."@en .

vdo:FunctionalRequirement a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Functional Requirement"@en ;
    rdfs:comment "Functional specification of system behavior."@en .

vdo:NonFunctionalRequirement a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Non-Functional Requirement"@en ;
    rdfs:comment "Quality attribute requirement (performance, security, reliability, etc.)."@en .

vdo:ArchitectureDecision a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Architecture Decision"@en ;
    rdfs:comment "Architecture decision recorded in an ADR."@en .

vdo:ArchitectureDecisionRecord a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Architecture Decision Record"@en ;
    rdfs:comment "A file containing one or more architecture decisions."@en .

vdo:Specification a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Specification"@en ;
    rdfs:comment "A specification document defining system requirements, behavior, or design."@en .

vdo:CodeArtifact a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Code Artifact"@en ;
    rdfs:comment "A source code file or module implementing system functionality."@en .

vdo:Service a owl:Class ;
    rdfs:subClassOf vdo:CodeArtifact ;
    rdfs:label "Microservice"@en ;
    rdfs:comment "A deployable microservice component."@en .

vdo:CLICommand a owl:Class ;
    rdfs:subClassOf vdo:CodeArtifact ;
    rdfs:label "CLI Command"@en ;
    rdfs:comment "A command-line interface command implementation."@en .

vdo:ErrorCode a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Error Code"@en ;
    rdfs:comment "A structured error code used for error classification and handling."@en .

vdo:SecurityBoundary a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Security Boundary"@en ;
    rdfs:comment "A security boundary defining authentication, authorization, or data protection constraints."@en .

vdo:TestSuite a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Test Suite"@en ;
    rdfs:comment "A collection of tests verifying system behavior."@en .

vdo:TestContract a owl:Class ;
    rdfs:subClassOf vdo:TestSuite ;
    rdfs:label "Test Contract"@en ;
    rdfs:comment "A contract test verifying specific requirements or behavioral guarantees."@en .

vdo:Documentation a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Documentation"@en ;
    rdfs:comment "User, developer, or operational documentation."@en .

vdo:DesignArtifact a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Design Artifact"@en ;
    rdfs:comment "UI/UX design specifications or wireframes."@en .

vdo:DeploymentConfig a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Deployment Configuration"@en ;
    rdfs:comment "Deployment and infrastructure configuration (Docker Compose, Helm, etc.)."@en .

vdo:ObservabilityConfig a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Observability Configuration"@en ;
    rdfs:comment "Monitoring, logging, tracing, and alerting configuration."@en .

vdo:CIPipeline a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "CI/CD Pipeline"@en ;
    rdfs:comment "Continuous integration and deployment pipeline definition."@en .

vdo:ContextAnnotation a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Context Annotation"@en ;
    rdfs:comment "An HLV context annotation grouping related artifacts under a functional scope."@en .

vdo:UseCase a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "Use Case"@en ;
    rdfs:comment "A use case specification describing user-system interaction."@en .

vdo:UserStory a owl:Class ;
    rdfs:subClassOf vdo:Artifact ;
    rdfs:label "User Story"@en ;
    rdfs:comment "A user story describing a feature from the user's perspective."@en .

# =============================================================================
# PROPERTIES — Traceability Relationships
# =============================================================================

vdo:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    rdfs:comment "Code artifact implements a requirement, specification, or use case."@en ;
    rdfs:domain vdo:CodeArtifact ;
    rdfs:range vdo:Artifact .

vdo:validates a owl:ObjectProperty ;
    rdfs:label "validates"@en ;
    rdfs:comment "Test suite validates a requirement, specification, or code behavior."@en ;
    rdfs:domain vdo:TestSuite ;
    rdfs:range vdo:Artifact .

vdo:tracesTo a owl:ObjectProperty ;
    rdfs:label "traces to"@en ;
    rdfs:comment "Generic traceability link between any two artifacts."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:Artifact .

vdo:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies"@en ;
    rdfs:comment "An artifact satisfies a requirement or constraint."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:Artifact .

vdo:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    rdfs:comment "A constraint (security, performance, etc.) that limits design or implementation choices."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:Artifact .

vdo:deploys a owl:ObjectProperty ;
    rdfs:label "deploys"@en ;
    rdfs:comment "Deployment configuration deploys and orchestrates a service."@en ;
    rdfs:domain vdo:DeploymentConfig ;
    rdfs:range vdo:Service .

vdo:monitors a owl:ObjectProperty ;
    rdfs:label "monitors"@en ;
    rdfs:comment "Observability configuration monitors a service."@en ;
    rdfs:domain vdo:ObservabilityConfig ;
    rdfs:range vdo:Service .

vdo:documents a owl:ObjectProperty ;
    rdfs:label "documents"@en ;
    rdfs:comment "Documentation describes or explains an artifact."@en ;
    rdfs:domain vdo:Documentation ;
    rdfs:range vdo:Artifact .

vdo:references a owl:ObjectProperty ;
    rdfs:label "references"@en ;
    rdfs:comment "References another artifact for additional context or detail."@en .

vdo:belongsTo a owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    rdfs:comment "Artifact belongs to a context, category, or parent artifact."@en .

vdo:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "Artifact depends on or requires another artifact."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:Artifact .

vdo:definesError a owl:ObjectProperty ;
    rdfs:label "defines error"@en ;
    rdfs:comment "Code artifact defines an error code."@en ;
    rdfs:domain vdo:CodeArtifact ;
    rdfs:range vdo:ErrorCode .

vdo:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified by"@en ;
    rdfs:comment "Artifact is verified by a test suite."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:TestSuite .

vdo:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by"@en ;
    rdfs:comment "Change impact: artifact is affected by changes to another artifact."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range vdo:Artifact .

vdo:definedBy a owl:ObjectProperty ;
    rdfs:label "defined by"@en ;
    rdfs:comment "An error code is defined by the code artifacts that produce it."@en ;
    rdfs:domain vdo:ErrorCode ;
    rdfs:range vdo:CodeArtifact .

# =============================================================================
# DATA PROPERTIES
# =============================================================================

vdo:annotationType a owl:DatatypeProperty ;
    rdfs:label "annotation type"@en ;
    rdfs:comment "The type of HLV annotation (artifact, sec, ctx, inv)."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range xsd:string .

vdo:coverageLevel a owl:DatatypeProperty ;
    rdfs:label "coverage level"@en ;
    rdfs:comment "Traceability coverage level: full, partial, stub, missing."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range xsd:string .

vdo:language a owl:DatatypeProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "Programming language of a code artifact."@en ;
    rdfs:domain vdo:CodeArtifact ;
    rdfs:range xsd:string .

vdo:filePath a owl:DatatypeProperty ;
    rdfs:label "file path"@en ;
    rdfs:comment "File path relative to project root."@en ;
    rdfs:domain vdo:Artifact ;
    rdfs:range xsd:string .

# =============================================================================
# INSTANCES — Business Requirements & Contexts
# =============================================================================

# --- Context Definitions ---

base:context/PLAT-LOCAL-002 a vdo:ContextAnnotation ;
    rdfs:label "PLAT-LOCAL-002"@en ;
    rdfs:comment "Platform local development and build context"@en ;
    vdo:filePath "src/Makefile", "tests/*" ;
    vdo:annotationType "ctx" .

base:context/DEPLOY-OPS-001 a vdo:ContextAnnotation ;
    rdfs:label "DEPLOY-OPS-001"@en ;
    rdfs:comment "Deployment operations and CI/CD context"@en ;
    vdo:filePath "deploy/ci/gitlab-ci.yml", "deploy/helm/values.yaml" ;
    vdo:annotationType "ctx" .

base:context/OBS-OPS-001 a vdo:ContextAnnotation ;
    rdfs:label "OBS-OPS-001"@en ;
    rdfs:comment "Observability operations context"@en ;
    vdo:filePath "deploy/observability/*" ;
    vdo:annotationType "ctx" .

base:context/GUI-OW-001 a vdo:ContextAnnotation ;
    rdfs:label "GUI-OW-001"@en ;
    rdfs:comment "Frontend GUI operations workspace context"@en ;
    vdo:filePath "src/services/frontend/src/" ;
    vdo:annotationType "ctx" .

# --- Service Definitions ---

base:service/api-gateway a vdo:Service ;
    rdfs:label "API Gateway"@en ;
    rdfs:comment "REST API Gateway — single entry point for all external requests"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/api-gateway/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/ontology-service a vdo:Service ;
    rdfs:label "Ontology Service"@en ;
    rdfs:comment "Ontology CRUD operations on Neo4j graph database"@en ;
    vdo:language "Rust" ;
    vdo:filePath "src/services/ontology-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/versioning-service a vdo:Service ;
    rdfs:label "Versioning Service"@en ;
    rdfs:comment "Git-like versioning engine — commits, branches, diffs"@en ;
    vdo:language "Rust" ;
    vdo:filePath "src/services/versioning-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/auth-service a vdo:Service ;
    rdfs:label "Auth Service"@en ;
    rdfs:comment "Authentication and authorization via Keycloak OIDC/OAuth2"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/auth-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/frontend a vdo:Service ;
    rdfs:label "Frontend"@en ;
    rdfs:comment "Vue 3 web UI — ontology editor, workspace, collaboration"@en ;
    vdo:language "TypeScript" ;
    vdo:filePath "src/services/frontend/" ;
    vdo:belongsTo base:context/GUI-OW-001 .

base:service/metrics-service a vdo:Service ;
    rdfs:label "Metrics Service"@en ;
    rdfs:comment "Metrics and analytics aggregation"@en ;
    vdo:language "Python" ;
    vdo:filePath "src/services/metrics-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/commenting-service a vdo:Service ;
    rdfs:label "Commenting Service"@en ;
    rdfs:comment "Collaboration — comments, annotations, notifications"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/commenting-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/ticket-api a vdo:Service ;
    rdfs:label "Ticket API"@en ;
    rdfs:comment "Ticket management CRUD API"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/ticket-api/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/publisher-service a vdo:Service ;
    rdfs:label "Publisher Service"@en ;
    rdfs:comment "Ontology publishing pipeline"@en ;
    vdo:language "Rust" ;
    vdo:filePath "src/services/publisher-service/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/public-browse-api a vdo:Service ;
    rdfs:label "Public Browse API"@en ;
    rdfs:comment "Public read-only API for published ontologies"@en ;
    vdo:language "Rust" ;
    vdo:filePath "src/services/public-browse-api/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:service/publish-browse-ui a vdo:Service ;
    rdfs:label "Publish Browse UI"@en ;
    rdfs:comment "Public ontology viewer web UI"@en ;
    vdo:language "TypeScript" ;
    vdo:filePath "src/services/publish-browse-ui/" .

base:service/ticket-classifier a vdo:Service ;
    rdfs:label "Ticket Classifier"@en ;
    rdfs:comment "Auto-classification of tickets using ML"@en ;
    vdo:language "Python" ;
    vdo:filePath "src/services/ticket-classifier/" .

base:service/ticket-notifier a vdo:Service ;
    rdfs:label "Ticket Notifier"@en ;
    rdfs:comment "Email and WebSocket ticket notifications"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/ticket-notifier/" .

base:service/ticket-sync a vdo:Service ;
    rdfs:label "Ticket Sync"@en ;
    rdfs:comment "External system synchronization for tickets"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/ticket-sync/" .

base:service/ticket-telemetry-listener a vdo:Service ;
    rdfs:label "Ticket Telemetry Listener"@en ;
    rdfs:comment "Telemetry ingestion from external sources"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/ticket-telemetry-listener/" .

base:service/support-service a vdo:Service ;
    rdfs:label "Support Service"@en ;
    rdfs:comment "Support operations and incident management"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/services/support-service/" .

# --- CLI Commands ---

base:cli/vedo-cli a vdo:CLICommand ;
    rdfs:label "vedo-cli"@en ;
    rdfs:comment "Operator CLI tool for system management"@en ;
    vdo:language "Go" ;
    vdo:filePath "src/cli/" ;
    vdo:belongsTo base:context/PLAT-LOCAL-002 .

base:cli/close-ticket a vdo:CLICommand ;
    rdfs:label "Close Ticket Command"@en ;
    rdfs:comment "Operator command to close a ticket"@en ;
    vdo:filePath "src/cli/cmd/ticket/close.go" ;
    vdo:implements base:spec/cli-ticket-ops-001 .

base:cli/comment-ticket a vdo:CLICommand ;
    rdfs:label "Comment Ticket Command"@en ;
    rdfs:comment "Operator command to add comment to a ticket"@en ;
    vdo:filePath "src/cli/cmd/ticket/comment.go" ;
    vdo:implements base:spec/cli-ticket-ops-001 .

base:cli/list-tickets a vdo:CLICommand ;
    rdfs:label "List Tickets Command"@en ;
    rdfs:comment "Operator command to list and filter tickets"@en ;
    vdo:filePath "src/cli/cmd/ticket/list.go" ;
    vdo:implements base:spec/cli-ticket-ops-001 .

base:cli/reopen-ticket a vdo:CLICommand ;
    rdfs:label "Reopen Ticket Command"@en ;
    rdfs:comment "Operator command to reopen a closed ticket"@en ;
    vdo:filePath "src/cli/cmd/ticket/reopen.go" ;
    vdo:implements base:spec/cli-ticket-ops-001 .

base:cli/show-ticket a vdo:CLICommand ;
    rdfs:label "Show Ticket Command"@en ;
    rdfs:comment "Operator command to show ticket details"@en ;
    vdo:filePath "src/cli/cmd/ticket/show.go" ;
    vdo:implements base:spec/cli-ticket-ops-001 .

# --- Specifications ---

base:spec/cli-ticket-ops-001 a vdo:Specification ;
    rdfs:label "CLI Ticket Operations Specification"@en ;
    rdfs:comment "Specification for CLI ticket management commands"@en ;
    vdo:filePath "specs/requirements/" ;
    vdo:annotationType "hlv:artifact" .

base:spec/gui-ow-001 a vdo:Specification ;
    rdfs:label "GUI Ontology Workspace Specification"@en ;
    rdfs:comment "Specification for frontend ontology workspace GUI"@en ;
    vdo:filePath "specs/ui/" ;
    vdo:annotationType "hlv:artifact" .

# --- Architecture Decision Records ---

base:adr/stack-decisions a vdo:ArchitectureDecisionRecord ;
    rdfs:label "Technology Stack Decisions"@en ;
    rdfs:comment "Architecture decisions for technology stack (Vue 3, Go, Rust, Neo4j, etc.)"@en ;
    vdo:filePath "specs/adr/" .

base:adr/frontend-vue3 a vdo:ArchitectureDecision ;
    rdfs:label "Frontend: Vue 3"@en ;
    rdfs:comment "Decision to use Vue 3 with Composition API and TypeScript for the frontend"@en ;
    vdo:belongsTo base:adr/stack-decisions .

base:adr/backend-rust-go a vdo:ArchitectureDecision ;
    rdfs:label "Backend: Rust + Go"@en ;
    rdfs:comment "Decision to use Rust for performance-critical services (ontology, versioning) and Go for I/O-bound services (API gateway, auth)"@en ;
    vdo:belongsTo base:adr/stack-decisions .

base:adr/database-neo4j a vdo:ArchitectureDecision ;
    rdfs:label "Database: Neo4j + PostgreSQL"@en ;
    rdfs:comment "Decision to use Neo4j as primary triple store and PostgreSQL for version store"@en ;
    vdo:belongsTo base:adr/stack-decisions .

# =============================================================================
# INSTANCES — Non-Functional Requirements
# =============================================================================

base:nfr/performance-p95 a vdo:NonFunctionalRequirement ;
    rdfs:label "API p95 latency < 120ms"@en ;
    rdfs:comment "API response time p95 must be below 120ms, p99 below 250ms"@en ;
    vdo:filePath "specs/requirements/REQ-NFR.PERF*" .

base:nfr/scalability-1m-axioms a vdo:NonFunctionalRequirement ;
    rdfs:label "Support up to 1M axioms"@en ;
    rdfs:comment "Ontology must support up to 1 million axioms with acceptable performance"@en ;
    vdo:filePath "specs/requirements/REQ-NFR.PERF*" .

base:nfr/security-bola-bfla a vdo:NonFunctionalRequirement ;
    rdfs:label "BOLA/BFLA Protection"@en ;
    rdfs:comment "API must protect against Broken Object Level Authorization and Broken Function Level Authorization attacks"@en ;
    vdo:filePath "specs/requirements/REQ-NFR.SECURITY.bola-bfla-negative-tests.md" .

base:nfr/observability-otel a vdo:NonFunctionalRequirement ;
    rdfs:label "OpenTelemetry Observability"@en ;
    rdfs:comment "All services must emit OpenTelemetry traces, metrics, and structured logs"@en ;
    vdo:filePath "specs/stack.md" .

# =============================================================================
# INSTANCES — Security Boundaries
# =============================================================================

base:security/auth-boundary a vdo:SecurityBoundary ;
    rdfs:label "AUTH_BOUNDARY"@en ;
    rdfs:comment "Authentication and authorization boundary — all authenticated requests must pass through this boundary"@en ;
    vdo:annotationType "hlv:sec" .

base:security/secret-handling a vdo:SecurityBoundary ;
    rdfs:label "SECRET_HANDLING"@en ;
    rdfs:comment "Secret handling policy — secrets must come from environment variables or secret stores, not from Git repositories"@en ;
    vdo:annotationType "hlv:sec" .

base:security/input-validation a vdo:SecurityBoundary ;
    rdfs:label "INPUT_VALIDATION"@en ;
    rdfs:comment "Input validation — all external inputs must be validated before processing"@en ;
    vdo:annotationType "hlv:sec" .

base:security/code-quality a vdo:SecurityBoundary ;
    rdfs:label "CODE_QUALITY"@en ;
    rdfs:comment "Code quality gates enforced by linters (golangci-lint, clippy, ruff, biome)"@en ;
    vdo:annotationType "hlv:sec" .

base:security/network a vdo:SecurityBoundary ;
    rdfs:label "NETWORK"@en ;
    rdfs:comment "Network boundary — compose diagnostics connects to running services"@en ;
    vdo:annotationType "hlv:sec" .

base:security/pii-masking a vdo:SecurityBoundary ;
    rdfs:label "PII Masking"@en ;
    rdfs:comment "PII masking — redact sensitive attributes from logs and traces"@en ;
    vdo:annotationType "hlv:sec" .

# --- Security boundary traceability ---

base:security/auth-boundary vdo:constrains base:service/api-gateway .
base:security/auth-boundary vdo:constrains base:service/auth-service .
base:security/auth-boundary vdo:constrains base:service/frontend .
base:security/auth-boundary vdo:constrains base:cli/vedo-cli .
base:security/secret-handling vdo:constrains base:deploy/gitlab-ci-env-example .

# =============================================================================
# INSTANCES — Error Codes
# =============================================================================

base:error/CLI-TICKET-NOT-FOUND a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-NOT-FOUND"@en ;
    rdfs:comment "Ticket not found error — requested ticket ID does not exist"@en ;
    vdo:definedBy base:cli/close-ticket, base:cli/comment-ticket, base:cli/reopen-ticket, base:cli/show-ticket .

base:error/CLI-TICKET-UNAUTHORIZED a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-UNAUTHORIZED"@en ;
    rdfs:comment "Unauthorized — operator token is missing or invalid"@en ;
    vdo:definedBy base:cli/close-ticket, base:cli/comment-ticket, base:cli/list-tickets, base:cli/reopen-ticket, base:cli/show-ticket .

base:error/CLI-TICKET-INVALID-STATE a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-INVALID-STATE"@en ;
    rdfs:comment "Invalid state transition — ticket cannot transition from its current state"@en ;
    vdo:definedBy base:cli/close-ticket, base:cli/reopen-ticket .

base:error/CLI-TICKET-AUDIT-FAILED a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-AUDIT-FAILED"@en ;
    rdfs:comment "Audit log failure — unable to record audit entry for ticket operation"@en ;
    vdo:definedBy base:cli/close-ticket, base:cli/comment-ticket, base:cli/reopen-ticket .

base:error/CLI-TICKET-INVALID-FILTER a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-INVALID-FILTER"@en ;
    rdfs:comment "Invalid filter parameters — ticket list filter contains invalid values"@en ;
    vdo:definedBy base:cli/list-tickets .

base:error/CLI-GUARDRAIL-NOT-SATISFIED a vdo:ErrorCode ;
    rdfs:label "CLI-GUARDRAIL-NOT-SATISFIED"@en ;
    rdfs:comment "Guardrail controls not satisfied — command blocked by guardrail policy"@en ;
    vdo:filePath "src/cli/command.go" .

base:error/CLI-MFA-REQUIRED a vdo:ErrorCode ;
    rdfs:label "CLI-MFA-REQUIRED"@en ;
    rdfs:comment "Fresh MFA challenge required — command requires recent MFA verification"@en ;
    vdo:filePath "src/cli/command.go" .

base:error/CLI-TICKET-REQUIRED a vdo:ErrorCode ;
    rdfs:label "CLI-TICKET-REQUIRED"@en ;
    rdfs:comment "Ticket ID is mandatory for this command"@en ;
    vdo:filePath "src/cli/command.go" .

base:error/CLI-COMMAND-NOT-SUPPORTED a vdo:ErrorCode ;
    rdfs:label "CLI-COMMAND-NOT-SUPPORTED"@en ;
    rdfs:comment "Command not supported by the CLI framework"@en ;
