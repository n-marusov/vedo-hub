# =============================================================================
# INSTANCES — E2E Test Suites (Keycloak Auth)
# =============================================================================

base:test/keycloak-login-e2e a vdo:TestSuite ;
    rdfs:label "Keycloak Login E2E Tests"@en ;
    rdfs:comment "Playwright E2E tests for full Keycloak OIDC authorization code + PKCE login flow: unauthenticated redirect, Corporate SSO initiation, credential entry, callback handling, role assertion, invalid credential rejection"@en ;
    vdo:filePath "tests/e2e/playwright/tests/gui/user-stories/keycloak-login.spec.ts" ;
    vdo:validates base:user/US-auth.keycloak-login ;
    vdo:validates base:user/US-api.auth.jwt ;
    vdo:validates base:user/US-a11y.auth.authentication .

# --- Keycloak auth code artifacts traceability ---

base:gui/page/login vdo:implements base:user/US-auth.keycloak-login .
base:gui/page/auth-callback vdo:implements base:user/US-auth.keycloak-login .
base:auth/keycloak-module a vdo:CodeArtifact ;
    rdfs:label "Keycloak OIDC Auth Module"@en ;
    rdfs:comment "Keycloak OIDC client — authorization code flow with PKCE (initiateLogin, handleCallback, logout)"@en ;
    vdo:language "TypeScript" ;
    vdo:filePath "src/services/frontend/src/auth/keycloak.ts" ;
    vdo:implements base:user/US-auth.keycloak-login .

base:auth/session-module a vdo:CodeArtifact ;
    rdfs:label "Auth Session Management Module"@en ;
    rdfs:comment "JWT storage, role extraction, token validation in sessionStorage and localStorage"@en ;
    vdo:language "TypeScript" ;
    vdo:filePath "src/services/frontend/src/auth/session.ts" ;
    vdo:implements base:user/US-auth.keycloak-login .

base:security/auth-boundary vdo:constrains base:user/US-auth.keycloak-login .

# =============================================================================
# GraphQL Tightening — GraphQL to Graph-Only Boundary
# =============================================================================
# Added by $aif-implement for feature/graphql-graph-only-boundary branch.
# Documents artifacts modified/created during the GraphQL scope restriction:
# GraphQL = only graph navigation (class/property/individual queries).
# All non-graph reads and all mutations migrated to REST.
# =============================================================================

