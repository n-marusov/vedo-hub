{
  "id": "person",
  "name": "Person & Organization",
  "description": "Core ontology for people, organizations, events, locations, and documents",
  "domain": "General",
  "steps": [
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Person",
      "label": "Person",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "An individual human being" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Organization",
      "label": "Organization",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A group of people organized for a particular purpose" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Event",
      "label": "Event",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "An occurrence or happening" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Location",
      "label": "Location",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A geographic place or position" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Document",
      "label": "Document",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A written or printed work" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "ContactPoint",
      "label": "Contact Point",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A means of contacting a person or organization" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "fullName",
      "label": "full Name",
      "domain": "Person",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The full name of a person" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "birthDate",
      "label": "birth Date",
      "domain": "Person",
      "range": "xsd:dateTime",
      "annotations": { "rdfs:comment": "The date of birth of a person" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "email",
      "label": "email",
      "domain": "ContactPoint",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "An email address" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "telephone",
      "label": "telephone",
      "domain": "ContactPoint",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "A telephone number" }    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "organizationName",
      "label": "organization Name",
      "domain": "Organization",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The name of the organization" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "eventDate",
      "label": "event Date",
      "domain": "Event",
      "range": "xsd:dateTime",
      "annotations": { "rdfs:comment": "The date of the event" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "address",
      "label": "address",
      "domain": "Location",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "A physical address" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "worksFor",
      "label": "works For",
      "domain": "Person",
      "range": "Organization",
      "annotations": { "rdfs:comment": "Indicates that a person works for an organization" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "locatedIn",
      "label": "located In",
      "domain": "Thing",
      "range": "Location",
      "annotations": { "rdfs:comment": "Indicates the location of an entity" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "organizer",
      "label": "organizer",
      "domain": "Event",
      "range": "Organization",
      "annotations": { "rdfs:comment": "The organization organizing the event" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "attendee",
      "label": "attendee",
      "domain": "Event",
      "range": "Person",
      "annotations": { "rdfs:comment": "A person attending the event" }
    }
  ]
}
