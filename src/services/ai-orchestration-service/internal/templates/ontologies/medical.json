{
  "id": "medical",
  "name": "Healthcare & Clinical",
  "description": "Ontology for patients, diagnoses, treatments, medications, and healthcare providers",
  "domain": "Healthcare",
  "steps": [
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Patient",
      "label": "Patient",
      "parent_id": "Person",
      "annotations": { "rdfs:comment": "A person receiving medical care" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "HealthcareProvider",
      "label": "Healthcare Provider",
      "parent_id": "Organization",
      "annotations": { "rdfs:comment": "An organization or individual providing healthcare services" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Diagnosis",
      "label": "Diagnosis",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A medical diagnosis or condition" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Treatment",
      "label": "Treatment",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A medical treatment or procedure" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Medication",
      "label": "Medication",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A pharmaceutical drug or medicine" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Symptom",
      "label": "Symptom",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A physical or mental feature indicating a condition" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "diagnosisCode",
      "label": "diagnosis Code",
      "domain": "Diagnosis",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "ICD-10 or other diagnostic code" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "diagnosisDate",
      "label": "diagnosis Date",
      "domain": "Diagnosis",
      "range": "xsd:dateTime",
      "annotations": { "rdfs:comment": "Date of diagnosis" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "dosage",
      "label": "dosage",
      "domain": "Medication",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The prescribed dosage of the medication" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "severity",
      "label": "severity",
      "domain": "Symptom",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "Severity level of symptom or condition" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "diagnosedWith",
      "label": "diagnosed With",
      "domain": "Patient",
      "range": "Diagnosis",
      "annotations": { "rdfs:comment": "Associates a patient with their diagnoses" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "treatedBy",
      "label": "treated By",
      "domain": "Patient",
      "range": "HealthcareProvider",
      "annotations": { "rdfs:comment": "The healthcare provider treating the patient" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "prescribed",
      "label": "prescribed",
      "domain": "HealthcareProvider",
      "range": "Medication",
      "annotations": { "rdfs:comment": "Medication prescribed by a provider" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "undergoes",
      "label": "undergoes",
      "domain": "Patient",
      "range": "Treatment",
      "annotations": { "rdfs:comment": "Treatment undergone by a patient" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasSymptom",
      "label": "has Symptom",
      "domain": "Patient",
      "range": "Symptom",
      "annotations": { "rdfs:comment": "Symptom experienced by the patient" }
    }
  ]
}
