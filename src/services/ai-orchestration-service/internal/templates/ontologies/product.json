{
  "id": "product",
  "name": "Product & Catalog",
  "description": "Ontology for products, categories, manufacturers, reviews, and pricing",
  "domain": "E-commerce",
  "steps": [
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Product",
      "label": "Product",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A tangible or digital item offered for sale" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "ProductCategory",
      "label": "Product Category",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A category or group of products" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Manufacturer",
      "label": "Manufacturer",
      "parent_id": "Organization",
      "annotations": { "rdfs:comment": "An organization that produces products" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Review",
      "label": "Review",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "An evaluation or critique of a product" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Price",
      "label": "Price",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "The monetary value of a product" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "productName",
      "label": "product Name",
      "domain": "Product",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The name of the product" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "sku",
      "label": "SKU",
      "domain": "Product",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "Stock keeping unit identifier" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "priceValue",
      "label": "price Value",
      "domain": "Price",
      "range": "xsd:decimal",
      "annotations": { "rdfs:comment": "The monetary value" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "currency",
      "label": "currency",
      "domain": "Price",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The currency code (ISO 4217)" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "stockQuantity",
      "label": "stock Quantity",
      "domain": "Product",
      "range": "xsd:integer",
      "annotations": { "rdfs:comment": "Available stock count" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasCategory",
      "label": "has Category",
      "domain": "Product",
      "range": "ProductCategory",
      "annotations": { "rdfs:comment": "Associates a product with its category" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "manufacturedBy",
      "label": "manufactured By",
      "domain": "Product",
      "range": "Manufacturer",
      "annotations": { "rdfs:comment": "The manufacturer of the product" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasReview",
      "label": "has Review",
      "domain": "Product",
      "range": "Review",
      "annotations": { "rdfs:comment": "Links a product to its reviews" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasPrice",
      "label": "has Price",
      "domain": "Product",
      "range": "Price",
      "annotations": { "rdfs:comment": "The price of the product" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasInventory",
      "label": "has Inventory",
      "domain": "Product",
      "range": "Product",
      "annotations": { "rdfs:comment": "Links product to its inventory record" }
    }
  ]
}
