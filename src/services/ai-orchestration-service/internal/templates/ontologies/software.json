{
  "id": "software",
  "name": "Software & System Architecture",
  "description": "Ontology for software components, APIs, services, dependencies, and versioning",
  "domain": "IT & Software",
  "steps": [
    {
      "operation": "CREATE_CLASS",
      "entity_id": "SoftwareComponent",
      "label": "Software Component",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A modular part of a software system" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "APIService",
      "label": "API Service",
      "parent_id": "SoftwareComponent",
      "annotations": { "rdfs:comment": "A service exposing an API endpoint" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Database",
      "label": "Database",
      "parent_id": "SoftwareComponent",
      "annotations": { "rdfs:comment": "A data storage system" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Dependency",
      "label": "Dependency",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "An external library or module required by a component" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "Version",
      "label": "Version",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "A specific release or iteration of software" }
    },
    {
      "operation": "CREATE_CLASS",
      "entity_id": "DeploymentEnvironment",
      "label": "Deployment Environment",
      "parent_id": "Thing",
      "annotations": { "rdfs:comment": "An environment where software is deployed" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "componentName",
      "label": "component Name",
      "domain": "SoftwareComponent",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The name of the software component" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "apiEndpoint",
      "label": "API Endpoint",
      "domain": "APIService",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The base URL of the API" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "versionNumber",
      "label": "version Number",
      "domain": "Version",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "Semantic version number" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "dependencyName",
      "label": "dependency Name",
      "domain": "Dependency",
      "range": "xsd:string",
      "annotations": { "rdfs:comment": "The name of the dependency package" }
    },
    {
      "operation": "CREATE_DATATYPE_PROPERTY",
      "entity_id": "port",
      "label": "port",
      "domain": "SoftwareComponent",
      "range": "xsd:integer",
      "annotations": { "rdfs:comment": "Network port number" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "dependsOn",
      "label": "depends On",
      "domain": "SoftwareComponent",
      "range": "Dependency",
      "annotations": { "rdfs:comment": "Indicates a dependency on another component" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "hasVersion",
      "label": "has Version",
      "domain": "SoftwareComponent",
      "range": "Version",
      "annotations": { "rdfs:comment": "Associates a component with its version" }
    },
    {
      "operation": "CREATE_OBJECT_PROPERTY",
      "entity_id": "communicatesWith",
      "label": "communicates With",
      "domain": "SoftwareComponent",
      "range": "APIService",
      "annotations": { "rdfs:comment": "Indicates inter-service communication" }
    }
  ]
}
