# @ctx: CI variables template for PLAT-LOCAL-002
CI_REGISTRY_IMAGE=registry.example.com/vedo-core
CI_DOCKER_BUILDKIT=1
DOCKER_AUTH_CONFIG={"auths":{}}
# @hlv:sec [AUTH_BOUNDARY] - keycloak admin credentials define auth bootstrap boundary
KEYCLOAK_ADMIN=admin
# @hlv:sec [SECRET_HANDLING] - placeholder only, real secret must be injected by CI
KEYCLOAK_ADMIN_PASSWORD=change-me
MINIO_ROOT_USER=minio
# @hlv:sec [SECRET_HANDLING] - placeholder only, real secret must be injected by CI
MINIO_ROOT_PASSWORD=change-me
