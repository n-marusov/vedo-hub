{
  "id": null,
  "uid": "vedo-health",
  "title": "VEDO Core - Health",
  "tags": ["vedo", "health", "observability"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Uptime",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(up{job=~\"vedo-.*\"})", "legendFormat": "Services Up" }
      ],
      "description": "Count of VEDO Core services currently reporting up"
    },
    {
      "id": 2,
      "title": "Service Status",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "up{job=~\"vedo-.*\"}", "legendFormat": "{{ job }}" }
      ],
      "description": "Per-service up/down status"
    },
    {
      "id": 3,
      "title": "Neo4j Connectivity",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "vedo_neo4j_up", "legendFormat": "Neo4j" }
      ],
      "description": "Neo4j database connectivity status"
    },
    {
      "id": 4,
      "title": "Request Rate (all services)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(vedo_http_requests_total[5m]))", "legendFormat": "Requests/s" }
      ],
      "description": "Aggregate request rate across all VEDO Core services"
    }
  ]
}
