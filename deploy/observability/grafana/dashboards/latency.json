{
  "id": null,
  "uid": "vedo-latency",
  "title": "VEDO Core - Latency",
  "tags": ["vedo", "latency", "observability"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "p99 Latency by Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(vedo_http_request_duration_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{ service }}" }
      ],
      "description": "p99 request duration in seconds per service"
    },
    {
      "id": 2,
      "title": "p95 Latency by Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(vedo_http_request_duration_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{ service }}" }
      ],
      "description": "p95 request duration in seconds per service"
    },
    {
      "id": 3,
      "title": "p50 Latency by Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(vedo_http_request_duration_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{ service }}" }
      ],
      "description": "p50 request duration in seconds per service"
    },
    {
      "id": 4,
      "title": "Average Latency by Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(vedo_http_request_duration_seconds_sum[5m]) / rate(vedo_http_request_duration_seconds_count[5m])", "legendFormat": "{{ service }}" }
      ],
      "description": "Average request duration in seconds per service"
    }
  ]
}
